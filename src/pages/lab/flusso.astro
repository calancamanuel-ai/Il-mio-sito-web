---
/** Prova isolata della "macchina del flusso": due varianti di look da scegliere (fase 3). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlowMachine from '../../components/three/FlowMachine.astro';
const varianti = [
  { id: 'v-vetro', look: 'vetro' as const, nome: 'Variante 1 · Vetro e luce', idea: 'Nodi di vetro satinato, connettori di metallo, un tubo di luce verde. Camera quasi frontale, bagliore lieve solo dentro la scena (su desktop). È la più scenografica.' },
  { id: 'v-circuito', look: 'circuito' as const, nome: 'Variante 2 · Scheda elettronica', idea: 'Una scheda vista dall’alto: chip opachi con i piedini, piste verdi ad angolo retto, carte opache. Niente bagliore. È più tecnica, si collega alla mappa a circuito di "Chi sono" e costa meno al telefono.' },
];
const tappe = [0, 40, 70, 100];
---
<BaseLayout title="Prova: la macchina del flusso" description="Due varianti di look per la scena 3D della home.">
  <section class="section lab-intro" aria-labelledby="titolo">
    <h1 id="titolo">La macchina del flusso, due look</h1>
    <p class="lead">Stessa scena e stessa coreografia, due materiali e due camere. Muovi il cursore per vedere le tappe (in home lo farà lo scroll) e tocca un nodo per sapere cosa fa.</p>
  </section>

  {varianti.map((v) => (
    <section class="section variant" aria-labelledby={`${v.id}-h`}>
      <div class="variant-head">
        <h2 id={`${v.id}-h`}>{v.nome}</h2>
        <p>{v.idea}</p>
      </div>
      <FlowMachine look={v.look} id={v.id} />
      <div class="controls" data-controls={v.id}>
        <label class="range">
          <span>Avanzamento: <output class="mono" data-out>0</output>%</span>
          <input type="range" min="0" max="100" value="0" data-range />
        </label>
        <div class="stops">
          {tappe.map((t) => <button type="button" data-stop={t}>{t}%</button>)}
          <button type="button" class="play" data-play>Riproduci</button>
        </div>
      </div>
    </section>
  ))}

  <p class="section stats mono" data-stats aria-live="polite"></p>
</BaseLayout>

<script>
  type Scene = import('../../components/three/flow-scene').FlowScene;
  document.querySelectorAll<HTMLElement>('[data-controls]').forEach((ctl) => {
    const root = document.getElementById(ctl.dataset.controls!) as HTMLElement & { flow?: Scene };
    const range = ctl.querySelector<HTMLInputElement>('[data-range]')!;
    const out = ctl.querySelector<HTMLOutputElement>('[data-out]')!;
    const set = (v: number) => { range.value = String(v); out.value = String(Math.round(v)); root.flow?.setProgress(v / 100); };
    range.addEventListener('input', () => set(Number(range.value)));
    ctl.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', () => set(Number(b.dataset.stop))));
    let raf = 0;
    ctl.querySelector('[data-play]')!.addEventListener('click', () => {
      cancelAnimationFrame(raf);
      const t0 = performance.now();
      const step = (t: number) => { const p = Math.min(1, (t - t0) / 6000); set(p * 100); if (p < 1) raf = requestAnimationFrame(step); };
      raf = requestAnimationFrame(step);
    });
    root.addEventListener('flow:ready', () => {
      set(Number(range.value));
      const stats = document.querySelector('[data-stats]');
      setTimeout(() => { if (stats && root.flow) { const i = root.flow.info(); stats.textContent += `${ctl.dataset.controls}: ${i.calls} draw call, ${i.triangles} triangoli. `; } }, 800);
    });
  });
</script>

<style>
  .lab-intro { display: grid; gap: var(--space-3); padding-top: clamp(3rem, 8vh, 6rem); }
  h1 { font-size: var(--step-head); font-weight: 300; line-height: 1; max-width: 18ch; }
  .variant { display: grid; gap: var(--space-3); }
  .variant-head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-4); align-items: end; }
  .variant-head h2 { font-size: var(--step-lead); font-weight: 500; }
  .variant-head p { max-width: 56ch; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .range { display: grid; gap: 0.3rem; flex: 1 1 18rem; }
  .range input { width: 100%; min-height: var(--tap); accent-color: var(--c-action); }
  .stops { display: flex; flex-wrap: wrap; gap: 4px; }
  .stops button { min-height: var(--tap); padding: 0 0.9rem; border: 0; background: var(--c-surface); color: var(--c-ink); font: inherit; cursor: pointer; }
  .stops button:hover { background: var(--c-line); }
  .stops .play { background: var(--c-action); color: var(--c-on-action); font-weight: 700; }
  .stats { color: var(--c-ink-soft); font-size: var(--step-small); }
  @media (max-width: 760px) { .variant-head { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }
</style>
