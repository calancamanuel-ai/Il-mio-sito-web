---
/**
 * Direzione B, "audace": Capitoli di colore (colour-chapters, seed 1523812705).
 * Palette Segnale (blu notte + arancio #FF7A1A), Schibsted Grotesk + Martian Mono.
 * Cosa viva in bozza: "Costruisci la tua automazione".
 */
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/martian-mono';
import BaseLayout from '../../layouts/BaseLayout.astro';
import schibstedLatin from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import LabBar from '../../components/ui/LabBar.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import FlowFallback from '../../components/three/FlowFallback.astro';
import FragmentWorkflow from '../../components/ui/FragmentWorkflow.astro';
import FragmentDraft from '../../components/ui/FragmentDraft.astro';
import FragmentSite from '../../components/ui/FragmentSite.astro';
import BuildAutomation from '../../components/demos/BuildAutomation.astro';
import NotWorthIt from '../../components/sections/NotWorthIt.astro';
import AfterContact from '../../components/sections/AfterContact.astro';
import PersonNote from '../../components/sections/PersonNote.astro';
import Value from '../../components/ui/Value.astro';
import { contatti, prezzi } from '../../config/sito';
import { hero, macchina, lunedi, servizi, passi, faq, chiusura } from '../../content/home';

const eur = (n: number) => new Intl.NumberFormat('it-IT').format(n) + ' €';
const piani = ['workflow-semplice', 'workflow-ai', 'sito-premium'].map((id) => prezzi.voci.find((v) => v.id === id)!);
const altri = prezzi.voci.filter((v) => !['workflow-semplice', 'workflow-ai', 'sito-premium'].includes(v.id));
---
<BaseLayout title="Direzione B · Capitoli di colore" description="Bozza della direzione creativa B, audace." preloadFonts={[schibstedLatin]}>
  <LabBar slot="top" current="b" />

  <section class="ch ch-navy hero" aria-labelledby="titolo">
    <h1 id="titolo"><span class="l1">Meno caos,</span> <span class="l2">più flusso.</span></h1>
    <div class="hero-side">
      <p>{hero.sottotitolo}</p>
      <ButtonLink href={contatti.linkPrenotazione}>Prenota una call di 20 minuti</ButtonLink>
    </div>
  </section>

  <section class="ch ch-orange machine" aria-labelledby="macchina">
    <h2 id="macchina" class="visually-hidden">La macchina del flusso</h2>
    <p class="statement">{macchina}</p>
    <FlowFallback class="machine-flow" />
    <p class="machine-note">Tocca un nodo per vedere cosa fa. Qui arriverà la scena 3D "La macchina del flusso".</p>
  </section>

  <section class="ch ch-surface monday" aria-labelledby="lunedi">
    <h2 id="lunedi">Il lunedì mattina</h2>
    <ol>
      {lunedi.map((m) => <li><span class="mono">{m.t}</span><s>{m.prima}</s><span class="now">{m.dopo}</span></li>)}
    </ol>
    <p class="small">Una mattina d'esempio in un'impresa di cinque persone.</p>
  </section>

  <section class="ch ch-paper services" aria-labelledby="servizi">
    <h2 id="servizi">Tre modi di togliere lavoro</h2>
    <div class="svc-grid">
      {servizi.map((s) => (
        <article class={`svc svc--${s.id}`}>
          {s.id === 'wf' && <FragmentWorkflow />}
          {s.id === 'draft' && <FragmentDraft />}
          {s.id === 'site' && <FragmentSite />}
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ch ch-navy builder" id="costruisci" aria-labelledby="costruisci-h">
    <h2 id="costruisci-h">Costruisci la tua automazione</h2>
    <p class="lead">Scegli tre blocchi. Il flusso si monta da solo, con tempo e prezzo indicativi.</p>
    <BuildAutomation />
  </section>

  <section class="ch ch-blue pricing" aria-labelledby="prezzi">
    <h2 id="prezzi">Prezzi di lancio</h2>
    <p class="pricing-intro">Per i primi {prezzi.clientiLancio} clienti. Dopo l'analisi gratuita ricevi un preventivo a prezzo fisso, che non cambia in corso d'opera.</p>
    <div class="steps-tiles">
      {piani.map((v, i) => (
        <article class={`tile tile--${i}`}>
          <h3>{v.nome}</h3>
          <p class="price">da {eur(v.da)}</p>
          <p>{v.esempio}</p>
        </article>
      ))}
    </div>
    <ul class="others">
      {altri.map((v) => <li><strong>{v.nome}</strong>: {v.gratuita ? 'gratuita' : `da ${eur(v.da)}${v.periodo ? ` al ${v.periodo}` : ''}`}</li>)}
    </ul>
    <p class="small">{prezzi.fattoriPrezzo} A parte i costi ricorrenti: {prezzi.costiRicorrenti.map((c) => `${c.nome.toLowerCase()} ${c.valore}`).join('; ')}.</p>
  </section>

  <section class="ch ch-paper method" aria-labelledby="metodo">
    <h2 id="metodo">Come lavoro</h2>
    <ol class="method-list">
      {passi.map((p) => <li><h3>{p.h}</h3><p>{p.p}</p></li>)}
    </ol>
    <AfterContact />
  </section>

  <NotWorthIt class="nw-b" />

  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="faq-head">Domande frequenti</h2>
    {faq.map((f) => (
      <div class="faq-band">
        <h3>{f.q}</h3>
        <p>{f.a}{f.segnaposto && <Value value={f.segnaposto} />}{f.dopo}</p>
      </div>
    ))}
  </section>

  <section class="close" aria-labelledby="close-h">
    <div class="close-side" aria-hidden="true"></div>
    <div class="close-main">
      <h2 id="close-h">{chiusura}</h2>
      <ButtonLink href={contatti.linkPrenotazione}>Prenota una call</ButtonLink>
    </div>
    <div class="close-side close-side--person"><PersonNote /></div>
  </section>
</BaseLayout>

<style is:global>
  html:root {
    --c-bg: #0b1220;
    --c-surface: #131d34;
    --c-line: #26344f;
    --c-ink: #f2f4f8;
    --c-ink-soft: #a7b1c4;
    --c-action: #ff7a1a;
    --c-on-action: #0b1220;
    --c-accent: #6f9bff;
    --c-ok: #34d399;
    --font-display: 'Schibsted Grotesk Variable', 'Arial Narrow', sans-serif;
    --font-text: 'Schibsted Grotesk Variable', system-ui, sans-serif;
    --font-mono: 'Martian Mono Variable', ui-monospace, monospace;
    --tracking-display: -0.045em;
  }
  .ch-paper {
    --c-bg: #eef1f6;
    --c-surface: #dde3ec;
    --c-line: #c3ccda;
    --c-ink: #0b1220;
    --c-ink-soft: #3d4a60;
    --c-action: #0b1220;
    --c-on-action: #eef1f6;
    --c-accent: #2f5fd0;
    --c-ok: #035c42;
    --c-placeholder: #6b3f00;
  }
  .ch-orange {
    --c-ink: #0b1220;
    --c-ink-soft: #2a1a0c;
    --c-action: #0b1220;
    --c-on-action: #ff7a1a;
  }
  .ch-blue {
    --c-ink: #0b1220;
    --c-ink-soft: #0b1220;
    --c-action: #0b1220;
    --c-on-action: #f2f4f8;
  }
</style>

<style>
  .ch { padding: clamp(4rem, 3rem + 5vw, 8rem) var(--margin); background: var(--c-bg); color: var(--c-ink); }
  .ch-navy { background: #0b1220; }
  .ch-surface { background: #131d34; }
  .ch-orange { background: #ff7a1a; }
  .ch-blue { background: #4f86f7; }
  h2 { font-size: clamp(2.5rem, 1rem + 5.6vw, 7rem); font-weight: 800; line-height: 0.9; max-width: 18ch; }
  .lead { margin-block: var(--space-3) var(--space-4); max-width: 46ch; font-size: var(--step-lead); }
  .small { margin-top: var(--space-3); font-size: 1rem; max-width: 70ch; }
  .mono { font-family: var(--font-mono); font-size: 0.95rem; }

  .hero { min-height: calc(100svh - 7rem); display: grid; align-content: space-between; gap: var(--space-5); }
  h1 { font-size: clamp(4rem, 1rem + 11vw, 13rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.05em; padding-top: 6vh; }
  h1 span { display: block; }
  .l2 { color: #ff7a1a; }
  .hero-side { justify-self: end; display: grid; gap: var(--space-3); justify-items: start; max-width: 34ch; font-size: 1.125rem; }

  .machine { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .statement { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; max-width: 30ch; }
  .machine :global(.flow) { --flow-ground: #0b1220; --flow-card: #131d34; --c-ink: #f2f4f8; --c-ink-soft: #a7b1c4; --c-action: #ff7a1a; color: #f2f4f8; font-size: 1.0625rem; min-height: 50svh; }
  .machine :global(.node-text) { color: #f2f4f8; }
  .machine-note { font-weight: 600; }

  .monday ol { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-4); }
  .monday li { display: grid; grid-template-columns: 6rem 1fr; gap: 0.3rem 1.5rem; }
  .monday .mono { grid-row: span 2; color: #ff7a1a; padding-top: 0.6rem; }
  .monday s { font-size: clamp(1.5rem, 1rem + 2.2vw, 3rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; text-decoration-color: #ff7a1a; text-decoration-thickness: 4px; }

  .svc-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-4) 8px; margin-top: var(--space-5); }
  .svc { display: grid; gap: var(--space-2); align-content: start; }
  .svc--wf { grid-column: 1 / span 7; }
  .svc--draft { grid-column: 8 / span 5; margin-top: 8rem; }
  .svc--site { grid-column: 3 / span 6; }
  .svc h3 { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.5rem); margin-top: var(--space-2); }
  .svc p { max-width: 44ch; }

  .pricing-intro { margin-block: var(--space-3) var(--space-4); max-width: 52ch; font-size: var(--step-lead); }
  .steps-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; align-items: end; }
  .tile { display: grid; align-content: start; gap: 0.5rem; padding: 1.75rem; }
  .tile h3 { font-size: 1.5rem; }
  .price { font-size: clamp(2.25rem, 1.5rem + 2vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .tile--0 { min-height: 360px; background: #eef1f6; color: #0b1220; }
  .tile--1 { min-height: 480px; background: #ff7a1a; color: #0b1220; }
  .tile--2 { min-height: 600px; background: #0b1220; color: #f2f4f8; }
  .others { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: var(--space-4) 0 0; padding: 0; list-style: none; font-size: 1.125rem; }

  .method-list { margin: var(--space-4) 0 var(--space-4); padding: 0; list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .method { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0 var(--space-5); align-items: start; }
  .method h2 { grid-column: 1 / -1; }
  .method :global(.after) { padding: 1.75rem; background: var(--c-surface); margin-top: var(--space-4); }
  .method-list { grid-template-columns: 1fr; gap: var(--space-3); max-width: 60ch; }
  .method-list li { display: grid; grid-template-columns: 14rem 1fr; gap: 1rem; }
  .method-list li:first-child h3 { color: #b84a00; }
  .method-list h3 { font-size: 1.25rem; margin-bottom: 0.4rem; }

  .nw-b { --nw-ground: #131d34; padding-block: clamp(4rem, 3rem + 5vw, 8rem); }
  .faq-head { display: flex; align-items: flex-end; min-height: 34svh; padding: var(--space-4) var(--margin); background: #ff7a1a; color: #0b1220; max-width: none; }
  .faq-band { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-4); padding: 3.5rem var(--margin); }
  .faq-band:nth-of-type(even) { background: #131d34; }
  .faq-band h3 { font-size: clamp(1.375rem, 1.1rem + 0.9vw, 2rem); }
  .faq-band p { max-width: 60ch; }

  .close { display: grid; grid-template-columns: 2fr 8fr 2fr; gap: 10px; margin-top: var(--gap-section); }
  .close-main { display: grid; gap: var(--space-4); align-content: center; justify-items: start; min-height: 360px; padding: 2.5rem; background: #ff7a1a; color: #0b1220; --c-action: #0b1220; --c-on-action: #ff7a1a; }
  .close-main h2 { font-size: clamp(2rem, 1rem + 2.6vw, 3.5rem); max-width: 20ch; }
  .close-side { background: #4f86f7; }
  .close-side--person { display: grid; align-content: end; padding: 1rem; background: #131d34; }
  .close-side--person :global(.person) { grid-template-columns: 1fr; }
  .close-side--person :global(.person-text) { font-size: 0.95rem; }

  @media (max-width: 860px) {
    .hero-side { justify-self: start; }
    .svc-grid { grid-template-columns: 1fr; }
    .svc--wf, .svc--draft, .svc--site { grid-column: auto; margin-top: 0; }
    .steps-tiles, .method-list, .method { grid-template-columns: 1fr; }
    .tile--0, .tile--1, .tile--2 { min-height: 0; }
    .faq-band { grid-template-columns: 1fr; gap: var(--space-2); padding-block: 2rem; }
    .close { grid-template-columns: 1fr 1fr; }
    .close-main { grid-column: 1 / -1; order: -1; padding: 1.5rem; min-height: 300px; }
    .monday li { grid-template-columns: 4rem 1fr; gap: 0.3rem 0.75rem; }
    .method-list li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
