---
/**
 * Direzione A, "sicura": Il quaderno tecnico (editorial-report, seed 527067701).
 * Palette Circuito, Bricolage Grotesque + JetBrains Mono. Cosa viva in bozza: calcolatore.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabBar from '../../components/ui/LabBar.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import FlowFallback from '../../components/three/FlowFallback.astro';
import FragmentWorkflow from '../../components/ui/FragmentWorkflow.astro';
import FragmentDraft from '../../components/ui/FragmentDraft.astro';
import FragmentSite from '../../components/ui/FragmentSite.astro';
import SavingsCalculator from '../../components/demos/SavingsCalculator.astro';
import Value from '../../components/ui/Value.astro';
import { contatti, prezzi } from '../../config/sito';
import { hero, lunedi, servizi, passi, faq, chiusura } from '../../content/home';

const eur = (n: number) => new Intl.NumberFormat('it-IT').format(n) + ' €';
---
<BaseLayout title="Direzione A · Il quaderno tecnico" description="Bozza della direzione creativa A, sicura.">
  <LabBar slot="top" current="a" />

  <section class="masthead" aria-labelledby="titolo">
    <FlowFallback class="masthead-flow" />
    <div class="axis masthead-text">
      <h1 id="titolo">{hero.titolo}</h1>
      <p class="standfirst">{hero.sottotitolo}</p>
      <div class="actions">
        <ButtonLink href={contatti.linkPrenotazione}>Prenota una call di 20 minuti</ButtonLink>
        <a class="text-link" href="#calcolatore">Calcola quanto tempo perdi</a>
      </div>
    </div>
  </section>

  <section class="page-text" aria-labelledby="lunedi">
    <aside class="side-note">Una mattina d'esempio, in un'impresa di cinque persone.</aside>
    <div class="axis">
      <h2 id="lunedi">Il lunedì mattina, oggi e domani</h2>
      <ol class="monday">
        {lunedi.map((m) => (
          <li><span class="mono">{m.t}</span><span class="was">{m.prima}</span><span class="now">{m.dopo}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-colour" aria-labelledby="servizi">
    <h2 id="servizi" class="axis">Tre modi di togliere lavoro</h2>
    {servizi.map((s, i) => (
      <article class:list={['service', { 'service--flip': i % 2 === 1 }]}>
        <div class="service-text">
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </div>
        {s.id === 'wf' && <FragmentWorkflow class="service-frag" />}
        {s.id === 'draft' && <FragmentDraft class="service-frag" />}
        {s.id === 'site' && <FragmentSite class="service-frag" />}
      </article>
    ))}
  </section>

  <section class="page-text" id="calcolatore" aria-labelledby="calc-h">
    <div class="axis">
      <h2 id="calc-h">Quante ore ti restituisce?</h2>
      <p class="intro">Scegli la tua attività e cosa ti pesa di più: il conto si aggiorna mentre scegli.</p>
    </div>
    <div class="wide"><SavingsCalculator /></div>
  </section>

  <section class="page-text" aria-labelledby="metodo">
    <aside class="side-note">Dalla prima call al supporto, con un prezzo deciso prima di iniziare.</aside>
    <div class="axis">
      <h2 id="metodo">Come lavoro</h2>
      <ol class="steps">
        {passi.map((p) => <li><h3>{p.h}</h3><p>{p.p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="page-text" aria-labelledby="prezzi">
    <div class="wide">
      <table class="prices">
        <caption class="visually-hidden">Prezzi di lancio per i primi {prezzi.clientiLancio} clienti</caption>
        <thead>
          <tr><th scope="col" id="prezzi" class="prices-h">Prezzi di lancio</th><th scope="col">Esempio tipico</th><th scope="col">Da</th></tr>
        </thead>
        <tbody>
          {prezzi.voci.map((v) => (
            <tr><th scope="row">{v.nome}</th><td>{v.esempio}</td><td class="mono">{v.gratuita ? 'gratuita' : `${eur(v.da)}${v.periodo ? ` al ${v.periodo}` : ''}`}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="prices-note">Prezzo di lancio per i primi {prezzi.clientiLancio} clienti. Da 300 €: dopo l'analisi gratuita ricevi un preventivo a prezzo fisso, che non cambia in corso d'opera. A parte, i costi ricorrenti: {prezzi.costiRicorrenti.map((c) => `${c.nome.toLowerCase()} ${c.valore}`).join('; ')}.</p>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="faq-head">Domande frequenti</h2>
    {faq.map((f) => (
      <div class="faq-band">
        <h3>{f.q}</h3>
        <p>{f.a}{f.segnaposto && <Value value={f.segnaposto} />}{f.dopo}</p>
      </div>
    ))}
  </section>

  <section class="close" aria-labelledby="close-h">
    <h2 id="close-h">{chiusura}</h2>
    <ButtonLink href={contatti.linkPrenotazione}>Prenota una call</ButtonLink>
  </section>
</BaseLayout>

<style is:global>
  :root {
    --axis: 42%;
  }
</style>

<style>
  .axis { padding-left: var(--axis); padding-right: var(--margin); }
  .masthead { padding-bottom: var(--space-5); }
  .masthead-flow { --flow-ground: var(--c-surface); min-height: 45svh; }
  .masthead-text { padding-top: var(--space-4); }
  h1 {
    font-size: clamp(2.75rem, 1rem + 5.4vw, 6.25rem);
    line-height: 0.95;
    font-weight: 800;
    max-width: 11ch;
  }
  .standfirst {
    margin-top: var(--space-3);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    max-width: 42ch;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }
  .text-link { display: inline-block; padding-block: 0.6rem; font-weight: 600; }

  .page-text { position: relative; padding-block: var(--gap-section) 0; }
  .side-note {
    position: absolute;
    left: var(--margin);
    width: calc(var(--axis) - 2 * var(--margin) - 2rem);
    max-width: 28ch;
    padding-top: 0.6rem;
    color: var(--c-ink-soft);
  }
  h2 { font-size: var(--step-head); font-weight: 800; }
  .intro { margin-top: var(--space-2); max-width: 46ch; font-size: var(--step-lead); }
  .wide { padding-inline: var(--margin); margin-top: var(--space-4); }
  .mono { font-family: var(--font-mono); }

  .monday { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-3); }
  .monday li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.25rem 1rem; max-width: 52ch; }
  .monday .mono { grid-row: span 2; color: var(--c-action); padding-top: 0.15rem; }
  .was { font-size: var(--step-lead); font-weight: 600; text-decoration: line-through; text-decoration-color: var(--c-action); text-decoration-thickness: 3px; }
  .now { color: var(--c-ink); }

  .page-colour { margin-top: var(--gap-section); padding-block: var(--space-5); background: var(--c-surface); --flow-ground: var(--c-bg); }
  .page-colour :global(.frag) { background: var(--c-bg); }
  .service {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5) var(--margin) 0;
  }
  .service-text { max-width: 36ch; }
  .service h3 { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem); margin-bottom: var(--space-2); }
  .service--flip .service-text { order: 2; }

  .steps { margin: var(--space-4) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-3); max-width: 52ch; }
  .steps h3 { font-size: var(--step-lead); }

  .prices { width: 100%; border-collapse: collapse; font-size: clamp(1rem, 0.9rem + 0.4vw, 1.375rem); }
  .prices th, .prices td { padding: 1.1rem 1rem; text-align: left; vertical-align: top; }
  .prices thead th { font-weight: 600; color: var(--c-ink-soft); }
  .prices .prices-h { font-family: var(--font-display); font-size: var(--step-head); font-weight: 800; color: var(--c-ink); letter-spacing: var(--tracking-display); line-height: 1; }
  .prices tbody tr:nth-child(odd) { background: var(--c-surface); }
  .prices tbody th { font-weight: 700; }
  .prices td.mono { white-space: nowrap; color: var(--c-action); font-weight: 600; }
  .prices-note { margin-top: var(--space-3); max-width: 70ch; }

  .faq { margin-top: var(--gap-section); }
  .faq-head { display: flex; align-items: flex-end; min-height: 36svh; padding: var(--space-4) var(--margin); background: var(--c-action); color: var(--c-on-action); font-size: clamp(2.5rem, 1rem + 5vw, 6rem); }
  .faq-band { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-4); padding: 3.5rem var(--margin); }
  .faq-band:nth-of-type(even) { background: var(--c-surface); }
  .faq-band h3 { font-size: clamp(1.375rem, 1.1rem + 0.9vw, 2rem); }
  .faq-band p { max-width: 60ch; }

  .close { display: grid; gap: var(--space-4); justify-items: start; padding: var(--gap-section) var(--margin) 0; padding-left: var(--axis); }
  .close h2 { max-width: 18ch; }

  @media (max-width: 860px) {
    .axis, .close { padding-left: var(--margin); }
    .side-note { position: static; display: block; width: auto; padding: 0 var(--margin) var(--space-2); }
    .service { grid-template-columns: 1fr; }
    .service--flip .service-text { order: 0; }
    .faq-band { grid-template-columns: 1fr; gap: var(--space-2); padding-block: 2rem; }
    .prices thead { display: none; }
    .prices, .prices tbody, .prices tr, .prices th, .prices td { display: block; }
    .prices tr { padding: 1rem; }
    .prices th, .prices td { padding: 0.15rem 0; }
  }
</style>
