---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import MachineSection from '../components/sections/MachineSection.astro';
import MondayScene from '../components/sections/MondayScene.astro';
import ServiceClaims from '../components/sections/ServiceClaims.astro';
import BuildAutomation from '../components/demos/BuildAutomation.astro';
import MethodStairs from '../components/sections/MethodStairs.astro';
import PriceSection from '../components/sections/PriceSection.astro';
import NotWorthIt from '../components/sections/NotWorthIt.astro';
import Faq from '../components/sections/Faq.astro';
import CloseInverted from '../components/sections/CloseInverted.astro';
import FlowTrack from '../components/sections/FlowTrack.astro';
import { brand } from '../config/sito';
import { faq } from '../content/home';
---
<BaseLayout title="Automazioni, software con Claude e siti web" description={`${brand.promessa} Automazioni n8n, software su misura con Claude e siti web, da Persiceto, Bologna e Modena o da remoto.`}>
  <HomeHero />
  <MachineSection />
  <FlowTrack>
  <MondayScene />
  <ServiceClaims />

  <section class="section" id="costruisci" aria-labelledby="costruisci-h">
    <h2 id="costruisci-h" class="section-title">Costruisci la tua automazione</h2>
    <p class="lead build-lead">Scegli tre blocchi: cosa arriva, cosa fa l'AI, cosa succede alla fine. Vedi il flusso, il tempo che ti restituisce e il prezzo da cui parte.</p>
    <BuildAutomation />
  </section>

  <MethodStairs />
  <PriceSection />
  <NotWorthIt class="home-nw" />
  <Faq items={faq} />
  </FlowTrack>
  <CloseInverted />
</BaseLayout>

<style>
  .build-lead { margin-block: var(--space-3) var(--space-5); }
  :global(.home-nw) { margin-top: var(--gap-section); --nw-ground: var(--c-bg); }
</style>
