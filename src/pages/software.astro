---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import FragmentDraft from '../components/ui/FragmentDraft.astro';
import FragmentChat from '../components/ui/FragmentChat.astro';
import FragmentPanel from '../components/ui/FragmentPanel.astro';
import FragmentWorkflow from '../components/ui/FragmentWorkflow.astro';
import PriceSection from '../components/sections/PriceSection.astro';
import Faq from '../components/sections/Faq.astro';
import CloseInverted from '../components/sections/CloseInverted.astro';

const usi = [
  { h: 'Legge le richieste e prepara la risposta', p: 'Un assistente che conosce il tuo listino e i tuoi orari: scrive la bozza, tu la rileggi e la mandi.' },
  { h: 'Tira fuori i dati dai documenti', p: 'Contratti, bollette, verbali, schede tecniche: estrae quello che ti serve e lo mette in tabella.' },
  { h: 'Risponde su WhatsApp alle domande di sempre', p: 'Orari, prezzi base, disponibilità. Quando la domanda è nuova, passa la conversazione a te.' },
  { h: 'Un pannello fatto per il tuo lavoro', p: 'Una schermata semplice al posto di cinque fogli di calcolo: vedi a che punto sono richieste e pratiche.' },
];
const faq = [
  { q: 'Che cos’è Claude?', a: 'Un modello di intelligenza artificiale di Anthropic, bravo a leggere e scrivere testi. Lo uso come componente dentro programmi pensati per il tuo lavoro.' },
  { q: 'Può sbagliare?', a: 'Sì, come chiunque legga di fretta. Per questo i programmi preparano bozze e segnalano i dubbi: l’ultima parola resta tua.' },
  { q: 'Quanto costa usarlo ogni mese?', a: 'Si paga in base all’uso, cioè a quanti testi legge e scrive. La stima per il tuo caso è scritta nella proposta, separata dal prezzo del progetto.' },
  { q: 'I dati restano riservati?', a: 'Passo al modello solo il testo che serve e scelgo servizi e impostazioni che non usano i tuoi dati per addestrare i modelli. I dettagli sono nella proposta e nella privacy.' },
];
---
<BaseLayout title="Software su misura con Claude" description="Software su misura con Claude: programmi che leggono email e documenti, preparano bozze e rispondono su WhatsApp. Decidi sempre tu.">
  <PageIntro title="Un programma che legge al posto tuo" answer="Costruisco piccoli software con Claude che leggono email, documenti e messaggi, capiscono cosa serve e preparano la bozza. Tu controlli e decidi. Da 1.000 €, con prezzo fisso.">
    <FragmentDraft slot="aside" />
  </PageIntro>

  <section class="section" aria-labelledby="usi">
    <h2 id="usi" class="section-title">Cosa può fare per te</h2>
    <div class="uses">
      <ul class="use-list">
        {usi.map((u) => <li><h3>{u.h}</h3><p>{u.p}</p></li>)}
      </ul>
      <div class="uses-frags"><FragmentChat /><FragmentPanel /></div>
    </div>
    <div class="behind">
      <p class="behind-text">Dietro ogni bozza c'è un flusso come questo.</p>
      <FragmentWorkflow />
    </div>
  </section>

  <PriceSection ids={['analisi', 'workflow-ai', 'assistenza']} />
  <Faq items={faq} />
  <CloseInverted title="Le bozze le scrive lui." />
</BaseLayout>
<style>
  .uses { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--space-5); align-items: start; margin-top: var(--space-5); }
  .use-list { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .use-list h3 { font-size: var(--step-lead); font-weight: 500; margin-bottom: 0.4rem; }
  .use-list p { max-width: 44ch; }
  .uses-frags { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .behind { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-4); align-items: center; margin-top: var(--space-5); }
  .behind-text { font-size: var(--step-lead); line-height: 1.35; max-width: 26ch; }
  @media (max-width: 900px) { .behind { grid-template-columns: minmax(0, 1fr); } .uses { grid-template-columns: minmax(0, 1fr); } }
</style>
