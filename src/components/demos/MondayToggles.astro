---
/**
 * "Il lunedì mattina" con gli interruttori (bozza): ogni attività ripetitiva
 * si spegne quando la passi al sistema. Orari e minuti sono un esempio.
 */
const tasks = [
  { time: '08:05', text: 'Riscrivi a mano le richieste arrivate nel weekend', min: 40, then: 'Le trovi già in tabella, con nome e richiesta.' },
  { time: '08:45', text: 'Prepari tre preventivi copiando il listino', min: 55, then: 'Claude prepara le bozze, tu le rileggi e invii.' },
  { time: '09:40', text: 'Cerchi la fattura che il cliente dice di non avere', min: 20, then: 'Arriva da sola con il nome giusto nella cartella giusta.' },
  { time: '10:00', text: 'Mandi i promemoria degli appuntamenti', min: 25, then: 'Partono il giorno prima, su WhatsApp o per email.' },
  { time: '10:25', text: 'Rispondi a "a che punto è il mio ordine?"', min: 30, then: 'Il cliente riceve lo stato senza scriverti.' },
];
const onAtLoad = [1, 3];
---
<div class="monday" data-monday>
  <p class="monday-total" aria-live="polite">
    Restituiti questo lunedì: <span class="monday-num" data-total>0 min</span>
  </p>
  <ul class="monday-list">
    {tasks.map((t, i) => (
      <li class="band" data-min={t.min} data-on={onAtLoad.includes(i) ? '' : undefined} style={`--band:${i}`}>
        <span class="band-time">{t.time}</span>
        <span class="band-text">{t.text}</span>
        <button type="button" class="switch" role="switch" aria-checked={onAtLoad.includes(i) ? 'true' : 'false'} data-ui>
          <span class="visually-hidden">Passa al sistema: {t.text}</span>
          <span class="switch-knob" aria-hidden="true"></span>
        </button>
        <span class="band-then">{t.then} <strong>{t.min} minuti restituiti.</strong></span>
      </li>
    ))}
  </ul>
  <p class="monday-note">Una mattina d'esempio: attività e minuti cambiano da impresa a impresa. Quelli veri li misuriamo insieme nell'analisi gratuita.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-monday]').forEach((root) => {
    const total = root.querySelector<HTMLElement>('[data-total]')!;
    const render = () => {
      const mins = [...root.querySelectorAll<HTMLElement>('.band[data-on]')].reduce((s, b) => s + Number(b.dataset.min), 0);
      const h = Math.floor(mins / 60), m = mins % 60;
      total.textContent = h ? `${h} h ${m} min` : `${m} min`;
    };
    root.querySelectorAll<HTMLButtonElement>('.switch').forEach((btn) => {
      btn.addEventListener('click', () => {
        const band = btn.closest<HTMLElement>('.band')!;
        const on = btn.getAttribute('aria-checked') !== 'true';
        btn.setAttribute('aria-checked', String(on));
        band.toggleAttribute('data-on', on);
        render();
      });
    });
    render();
  });
</script>

<style>
  .monday { display: grid; gap: var(--space-3); }
  .monday-total {
    font-size: var(--step-lead);
    font-weight: 600;
  }
  .monday-num {
    font-family: var(--font-mono);
    color: var(--c-action);
  }
  .monday-list {
    margin: 0 calc(-1 * var(--margin));
    padding: 0;
    list-style: none;
  }
  .band {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-3);
    min-height: 20vh;
    padding: var(--space-3) var(--margin);
    background: var(--c-bg);
    transition: background-color 260ms var(--ease-out);
  }
  .band-time {
    font-family: var(--font-mono);
    color: var(--c-ink-soft);
  }
  .band-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    transition: color 260ms var(--ease-out);
  }
  .band-then {
    grid-column: 2 / 3;
    display: none;
    margin-top: 0.5rem;
    font-size: 1.0625rem;
  }
  .band[data-on] {
    background: var(--band-on, var(--c-surface));
  }
  .band[data-on] .band-text {
    color: var(--c-ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--c-action);
  }
  .band[data-on] .band-then { display: block; }
  .switch {
    position: relative;
    width: 4.25rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--c-line);
    cursor: pointer;
    transition: background-color var(--dur-ui) var(--ease-out);
  }
  .switch-knob {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--c-ink);
    transition: translate 220ms var(--ease-out);
  }
  .switch[aria-checked='true'] { background: var(--c-action); }
  .switch[aria-checked='true'] .switch-knob { translate: 1.75rem 0; background: var(--c-on-action); }
  .switch:active .switch-knob { scale: 0.92; }
  .monday-note { font-size: 1rem; max-width: 60ch; }
  @media (max-width: 760px) {
    .band {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.25rem;
      min-height: 132px;
    }
    .band-time { grid-column: 1 / -1; }
    .band-text { font-size: 1.3125rem; }
    .band-then { grid-column: 1 / -1; }
  }
</style>
