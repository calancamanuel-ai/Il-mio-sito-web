---
/**
 * "La macchina del flusso" come isola: il canvas 3D si carica solo quando la
 * sezione si avvicina allo schermo (import dinamico, come client:visible ma senza framework).
 * Senza WebGL, con movimento ridotto o senza JavaScript resta il fotogramma finale in HTML.
 * Le etichette dei nodi sono pulsanti HTML: tastiera e lettori di schermo hanno lo stesso contenuto del 3D.
 */
import FlowFallback from './FlowFallback.astro';
import type { LookId } from './flow-looks';
interface Props { look: LookId; id: string }
const { look, id } = Astro.props;
/** HDRI da studio di Poly Haven (CC0), ridotto con tools/riduci-hdri.mjs. */
const hdri = '/3d/studio_small_09_512.hdr.gz';
const nodes = [
  { label: 'Ricevi', text: 'Raccoglie email, messaggi e moduli in un unico punto.' },
  { label: 'Leggi con Claude', text: 'Capisce cosa chiede il cliente ed estrae i dati utili.' },
  { label: 'Archivia', text: 'Scrive i dati nel foglio o nel gestionale, senza copia e incolla.' },
  { label: 'Notifica', text: 'Ti avvisa sul telefono solo quando serve una tua decisione.' },
];
---
<div class="fm" id={id} data-flow data-look={look} data-hdri={hdri} data-texts={JSON.stringify(nodes.map((n) => n.text))}>
  <div class="fm-stage" hidden>
    <canvas class="fm-canvas" role="img" aria-label="Animazione: email, messaggi e documenti sparsi passano da quattro nodi (ricevi, leggi con Claude, archivia, notifica) e diventano un preventivo, una riga in tabella e una notifica."></canvas>
    <div class="fm-labels">
      {nodes.map((n, i) => <button type="button" class="fm-label mono" data-node={i} aria-pressed="false">{n.label}</button>)}
    </div>
    <p class="fm-info" aria-live="polite" data-info></p>
  </div>
  <div class="fm-fallback"><FlowFallback /></div>
</div>

<script>
  type Scene = import('./flow-scene').FlowScene;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasGL = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();

  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    if (reduce || !hasGL) return; // resta il fotogramma statico
    const stage = root.querySelector<HTMLElement>('.fm-stage')!;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const labels = [...root.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const info = root.querySelector<HTMLElement>('[data-info]')!;
    const texts: string[] = JSON.parse(root.dataset.texts || '[]');
    let scene: Scene | null = null;

    const select = (i: number) => {
      const same = labels[i].getAttribute('aria-pressed') === 'true';
      labels.forEach((b, k) => b.setAttribute('aria-pressed', String(!same && k === i)));
      info.textContent = same ? '' : texts[i];
      scene?.select(same ? null : i);
    };
    labels.forEach((b, i) => b.addEventListener('click', () => select(i)));

    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const { createFlowScene } = await import('./flow-scene');
      await new Promise((r) => requestAnimationFrame(r)); // lascia respirare il thread prima di avviare WebGL
      stage.hidden = false;
      root.querySelector<HTMLElement>('.fm-fallback')!.hidden = true;
      scene = createFlowScene(canvas, root.dataset.look as 'vetro' | 'circuito', {
        orbit: matchMedia('(pointer: fine)').matches,
        hdri: root.dataset.hdri,
        onSelect: select,
        onLabels: (pts, portrait) => pts.forEach((p, i) => {
          labels[i].style.transform = portrait
            ? `translate(${p.x}px, ${p.y}px) translate(2.4rem, -50%)`
            : `translate(${p.x}px, ${p.y}px) translate(-50%, 2.6rem)`;
          labels[i].dataset.on = String(p.visible);
        }),
      });
      (root as HTMLElement & { flow?: Scene }).flow = scene;
      root.dispatchEvent(new CustomEvent('flow:ready', { detail: scene }));
    }, { rootMargin: '300px 0px' });
    io.observe(root);
  });
</script>

<style>
  .fm { position: relative; }
  .fm-stage { position: relative; aspect-ratio: 16 / 7; min-height: 340px; background: var(--c-surface); overflow: hidden; }
  .fm-canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; cursor: pointer; }
  .fm-labels { position: absolute; inset: 0; pointer-events: none; }
  .fm-label {
    position: absolute;
    left: 0;
    top: 0;
    min-height: 36px;
    padding: 0.35rem 0.6rem;
    border: 0;
    background: var(--c-bg);
    color: var(--c-ink-soft);
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    transition: color var(--dur-ui) var(--ease-out), background-color var(--dur-ui) var(--ease-out), opacity var(--dur-ui) var(--ease-out);
  }
  .fm-label[data-on='false'] { opacity: 0.35; }
  .fm-label[data-on='true'] { color: var(--c-ink); }
  .fm-label[aria-pressed='true'] { background: var(--c-action); color: var(--c-on-action); opacity: 1; }
  .fm-info { position: absolute; left: var(--space-3); bottom: var(--space-3); max-width: 34ch; min-height: 1.5em; padding: 0; }
  .fm-info:not(:empty) { padding: 0.6rem 0.8rem; background: var(--c-bg); }
  @media (max-width: 760px) {
    .fm-stage { aspect-ratio: 3 / 5; min-height: 0; }
    .fm-label { font-size: 0.8125rem; }
  }
</style>
