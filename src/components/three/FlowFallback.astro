---
/**
 * Fotogramma finale statico della "macchina del flusso": a sinistra il caos,
 * al centro la catena di nodi, a destra gli stessi elementi in ordine.
 * È il fallback obbligatorio del 3D (movimento ridotto o senza WebGL)
 * e, in fase 1, l'immagine dell'hero nelle bozze. Dati d'esempio.
 */
interface Props {
  class?: string;
  /** Mostra la frase di cosa fa ogni nodo (tap/focus). */
  explain?: boolean;
}
const { class: extra = '', explain = true } = Astro.props;

const chaos = [
  { kind: 'email', title: 'Richiesta preventivo', meta: 'da: info@… · 07:42' },
  { kind: 'wa', title: '"Mi fate sapere il prezzo?"', meta: 'WhatsApp · 07:51' },
  { kind: 'pdf', title: 'fattura_0412.pdf', meta: 'allegato · 212 KB' },
  { kind: 'sheet', title: 'clienti_DEF_v3.xlsx', meta: 'modificato da 3 persone' },
];
const nodes = [
  { label: 'Ricevi', text: 'Raccoglie email, messaggi e moduli in un unico punto.' },
  { label: 'Leggi con Claude', text: 'Capisce cosa chiede il cliente ed estrae i dati utili.' },
  { label: 'Archivia', text: 'Scrive i dati nel foglio o nel gestionale, senza copia e incolla.' },
  { label: 'Notifica', text: 'Ti avvisa sul telefono solo quando serve una tua decisione.' },
];
const outputs = [
  { title: 'Bozza di preventivo', meta: 'pronta da rivedere' },
  { title: 'Riga in tabella', meta: 'cliente · richiesta · data' },
  { title: 'Notifica', meta: '"Nuova richiesta da approvare"' },
];
---
<figure class:list={['flow', extra]} data-ui aria-label="Esempio di flusso: dal caos dell'ufficio a un processo ordinato">
  <div class="flow-chaos" aria-label="Prima: cosa arriva">
    {chaos.map((c, i) => (
      <div class={`doc doc--${c.kind}`} style={`--i:${i}`}>
        <span class="doc-title">{c.title}</span>
        <span class="doc-meta">{c.meta}</span>
      </div>
    ))}
  </div>

  <ol class="flow-chain" aria-label="Il flusso">
    {nodes.map((n) => (
      <li class="node">
        {explain ? (
          <details>
            <summary><span class="node-label">{n.label}</span></summary>
            <p class="node-text">{n.text}</p>
          </details>
        ) : (
          <span class="node-label">{n.label}</span>
        )}
      </li>
    ))}
  </ol>

  <div class="flow-out" aria-label="Dopo: cosa esce">
    {outputs.map((o) => (
      <div class="out">
        <span class="out-ok" aria-hidden="true"></span>
        <span class="doc-title">{o.title}</span>
        <span class="doc-meta">{o.meta}</span>
      </div>
    ))}
  </div>
  <figcaption class="visually-hidden">Esempio illustrativo: quattro passaggi trasformano richieste sparse in un preventivo, una riga in tabella e una notifica.</figcaption>
</figure>

<style>
  .flow {
    --flow-line: 3px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    margin: 0;
    padding: clamp(1rem, 2.5vw, 2.5rem);
    background: var(--flow-ground, var(--c-surface));
    color: var(--c-ink);
    font-size: 1rem;
  }
  .flow-chaos {
    position: relative;
    display: grid;
    gap: 0.6rem;
  }
  .doc,
  .out {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    background: var(--flow-card, var(--c-bg));
    line-height: 1.3;
  }
  .doc {
    rotate: calc((var(--i) - 1.5) * 3.5deg);
    translate: calc(sin(var(--i) * 1.7rad) * 1.4rem) 0;
  }
  .doc--wa { background: var(--flow-wa, #1f3b2e); }
  .doc--pdf { background: var(--flow-pdf, #3a2330); }
  .doc-title { font-weight: 700; }
  .doc-meta {
    color: var(--c-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .flow-chain {
    position: relative;
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* la linea di flusso: piena, colore piatto, nessun bagliore */
  .flow-chain::before {
    content: '';
    position: absolute;
    left: 1.35rem;
    top: 1.4rem;
    bottom: 1.4rem;
    width: var(--flow-line);
    background: var(--flow-accent, var(--c-action));
  }
  .node { position: relative; }
  .node summary,
  .node > .node-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--tap);
    cursor: pointer;
    list-style: none;
  }
  .node summary::-webkit-details-marker { display: none; }
  .node summary::before,
  .node > .node-label::before {
    content: '';
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--flow-node, var(--c-accent));
    position: relative;
    z-index: 1;
  }
  .node details[open] summary::before { background: var(--flow-accent, var(--c-action)); }
  .node-label {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .node-text {
    max-width: 24ch;
    margin: 0.3rem 0 0 3.5rem;
    font-size: 0.95rem;
    color: var(--c-ink);
  }
  .flow-out {
    display: grid;
    gap: 0.6rem;
  }
  .out {
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
  }
  .out .doc-meta { grid-column: 2; }
  .out-ok {
    grid-row: span 2;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.35rem;
    background: var(--c-ok);
  }
  @media (max-width: 760px) {
    .flow { grid-template-columns: 1fr; }
    .flow-chaos { grid-template-columns: 1fr 1fr; }
    .doc { translate: 0 0; rotate: calc((var(--i) - 1.5) * 2deg); }
    .flow-out { grid-template-columns: 1fr; }
  }
</style>
