---
/**
 * Mappa della zona di partenza come circuito stampato (schema non in scala).
 * Le piste escono dai bordi: si parte da qui, non è un confine. Il tap sui paesi arriva in fase 4.
 */
const towns = [
  { n: 'San Giovanni in Persiceto', x: 527, y: 192, main: true },
  { n: 'Bologna', x: 782, y: 420 },
  { n: 'Modena', x: 92, y: 176 },
  { n: 'Crevalcore', x: 459, y: 70 },
  { n: "Sant'Agata Bolognese", x: 400, y: 160 },
  { n: 'Cento', x: 697, y: 56 },
  { n: 'Castelfranco Emilia', x: 289, y: 272 },
  { n: 'Anzola dell’Emilia', x: 560, y: 336 },
];
const p = towns[0];
const track = (t: { x: number; y: number }) => `M${p.x} ${p.y} H${(p.x + t.x) / 2} V${t.y} H${t.x}`;
---
<figure class="map" data-ui>
  <svg viewBox="0 0 880 480" role="img" aria-labelledby="map-title">
    <title id="map-title">Schema della zona: San Giovanni in Persiceto al centro, collegata a Bologna, Modena e ai paesi vicini; le piste continuano oltre il bordo.</title>
    <rect width="880" height="480" style="fill: var(--c-surface)" />
    <g fill="none" stroke-width="3" style="stroke: var(--c-line)">
      <path d="M782 420 H880" /><path d="M92 176 H0" /><path d="M697 56 V0" /><path d="M782 420 V480" /><path d="M289 272 V480" />
    </g>
    <g fill="none" stroke-width="3" style="stroke: var(--c-action)">
      {towns.slice(1).map((t) => <path d={track(t)} />)}
    </g>
    {towns.map((t) => (
      <g>
        <rect x={t.x - (t.main ? 14 : 9)} y={t.y - (t.main ? 14 : 9)} width={t.main ? 28 : 18} height={t.main ? 28 : 18} style={`fill: ${t.main ? 'var(--c-action)' : 'var(--c-accent)'}`} />
        <text x={t.x + (t.x > 700 ? -16 : 16)} y={t.y - 16} text-anchor={t.x > 700 ? 'end' : 'start'} font-size="17" style="fill: var(--c-ink); font-family: var(--font-mono)">{t.n}</text>
      </g>
    ))}
  </svg>
  <figcaption>Schema non in scala. Si parte da qui; per tutto il resto c'è la videochiamata.</figcaption>
</figure>
<style>
  .map { margin: 0; display: grid; gap: var(--space-1); }
  svg { width: 100%; height: auto; }
  figcaption { color: var(--c-ink-soft); }
</style>
