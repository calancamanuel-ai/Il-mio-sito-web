---
/**
 * Tema giorno/notte. Il tema iniziale segue il sistema (script in <head>, senza lampi);
 * la scelta fatta qui resta salvata nel browser. Il passaggio è un cerchio che si apre
 * dal pulsante (View Transitions), istantaneo con movimento ridotto o dove non è supportato.
 */
interface Props { withLabel?: boolean; class?: string }
const { withLabel = false, class: extra = '' } = Astro.props;
---
<button type="button" class:list={['theme-toggle', { 'theme-toggle--label': withLabel }, extra]} data-theme-toggle aria-label="Passa al tema chiaro">
  <svg class="ic-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><g class="rays"><rect x="11" y="1" width="2" height="4" /><rect x="11" y="19" width="2" height="4" /><rect x="1" y="11" width="4" height="2" /><rect x="19" y="11" width="4" height="2" /><rect x="4.2" y="3.2" width="2" height="4" transform="rotate(-45 5.2 5.2)" /><rect x="17.8" y="16.8" width="2" height="4" transform="rotate(-45 18.8 18.8)" /><rect x="17.8" y="3.2" width="2" height="4" transform="rotate(45 18.8 5.2)" /><rect x="4.2" y="16.8" width="2" height="4" transform="rotate(45 5.2 18.8)" /></g></svg>
  <svg class="ic-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
  {withLabel && <span class="tt-label" aria-hidden="true">Cambia tema</span>}
</button>

<script>
  const root = document.documentElement;
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
  const label = () => {
    const light = root.dataset.theme === 'light';
    btns.forEach((b) => b.setAttribute('aria-label', light ? 'Passa al tema scuro' : 'Passa al tema chiaro'));
  };
  label();
  btns.forEach((btn) => btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    const apply = () => {
      root.dataset.theme = next;
      try { localStorage.setItem('tema', next); } catch { /* storage non disponibile: vale solo per questa visita */ }
      label();
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    if (reduce || !doc.startViewTransition) { apply(); return; }
    const r = btn.getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const t = doc.startViewTransition(apply);
    t.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
        { duration: 520, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    }).catch(() => {});
  }));
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    background: var(--c-surface);
    color: var(--c-ink);
    cursor: pointer;
    transition: background-color var(--dur-ui) var(--ease-out);
  }
  .theme-toggle:hover { background: var(--c-line); }
  .theme-toggle--label { width: auto; display: inline-flex; gap: 0.6rem; padding: 0 1rem; font: inherit; font-size: var(--step-lead); }
  .theme-toggle svg { fill: currentColor; transition: transform 300ms var(--ease-out); }
  .theme-toggle:active svg { transform: rotate(-20deg) scale(0.9); }
  /* nel tema scuro si mostra il sole (passa al chiaro), nel chiaro la luna */
  .ic-moon { display: none; }
  :global(html[data-theme='light']) .ic-sun { display: none; }
  :global(html[data-theme='light']) .ic-moon { display: block; }
  :global(::view-transition-old(root)), :global(::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
</style>
