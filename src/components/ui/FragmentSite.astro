---
/** Frammento: anteprima di un sito dimostrativo (attività inventata, dichiarata). */
interface Props { class?: string }
const { class: extra = '' } = Astro.props;
---
<figure class:list={['frag', extra]} data-ui>
  <div class="frag-bar"><span>officina-bertelli.demo</span><span class="frag-tag">progetto dimostrativo</span></div>
  <div class="site">
    <div class="site-nav"><strong>Officina Bertelli</strong><span>Servizi · Orari · Prenota</span></div>
    <p class="site-h">Tagliando in giornata, a Sant'Agata.</p>
    <p class="site-p">Prenoti online, ti scriviamo su WhatsApp quando l'auto è pronta.</p>
    <span class="site-btn">Prenota il tagliando</span>
    <dl class="site-facts"><div><dt>Obiettivo LCP</dt><dd>&lt; 2,5 s</dd></div><div><dt>Obiettivo Lighthouse</dt><dd>95+</dd></div></dl>
  </div>
  <figcaption class="visually-hidden">Progetto dimostrativo di un sito per un'officina inventata, con i valori di prestazioni obiettivo.</figcaption>
</figure>
<style>
  .frag { margin: 0; background: var(--c-surface); color: var(--c-ink); font-size: 0.95rem; min-height: 220px; }
  .frag-bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 1rem; background: var(--c-line); font-family: var(--font-mono); font-size: 0.875rem; }
  .frag-tag { color: var(--c-placeholder); }
  .site { display: grid; gap: 0.7rem; padding: 1.1rem; background: #f3efe6; color: #1d1d1b; }
  .site-nav { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; }
  .site-h { font-family: Georgia, serif; font-size: 1.6rem; line-height: 1.1; max-width: 18ch; }
  .site-p { max-width: 40ch; }
  .site-btn { justify-self: start; padding: 0.5rem 0.9rem; background: #b3261e; color: #fff; font-weight: 700; }
  .site-facts { display: flex; gap: 1.5rem; margin: 0.3rem 0 0; }
  .site-facts dt { font-size: 0.875rem; color: #55524b; }
  .site-facts dd { margin: 0; font-family: var(--font-mono); font-weight: 700; }
</style>
