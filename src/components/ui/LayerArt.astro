---
/**
 * Un livello della prova a parallasse: l'immagine preparata da tools/prepara-livelli.mjs
 * (AVIF/WebP, versione telefono e computer) oppure, finché non c'è, un segnaposto disegnato in SVG.
 * Sempre decorativo (alt vuoto): il contenuto della scena è descritto da aria-label sulla scena.
 */
import manifest from '../../content/livelli.json';

interface Props { name: string }
const { name } = Astro.props;
type Version = { w: number; h: number; avif: string; webp: string };
const entry = (manifest.livelli as Record<string, { computer?: Version; telefono?: Version }>)[name];
const pc = entry?.computer ?? entry?.telefono;
const tel = entry?.telefono ?? entry?.computer;

// palette scura della scena (la scena resta scura anche col tema chiaro)
const paper = '#e7efe9', paper2 = '#c9d6cc', ink = '#2c3a31', green = '#4ade80', wa = '#1f3b2e', red = '#fca5a5', sky = '#7dd3fc', amber = '#fbbf24';
const arches = Array.from({ length: 9 }, (_, i) => i * 240 - 60);
---
{pc && tel ? (
  <picture class="art">
    <source media="(max-width: 760px)" type="image/avif" srcset={tel.avif} />
    <source media="(max-width: 760px)" type="image/webp" srcset={tel.webp} />
    <source type="image/avif" srcset={pc.avif} />
    <img src={pc.webp} width={pc.w} height={pc.h} alt="" loading="lazy" decoding="async" />
  </picture>
) : (
  <svg class="art art--ph" data-placeholder viewBox={
    name === 'sfondo' ? '0 0 2100 900' : name === 'primo-piano' ? '0 0 2100 500' :
    name === 'scontrino' ? '0 0 80 200' : name === 'postit' ? '0 0 120 120' : name === 'pdf' ? '0 0 120 150' : '0 0 200 140'
  } preserveAspectRatio={name === 'sfondo' ? 'xMidYMid slice' : name === 'primo-piano' ? 'xMidYMax slice' : 'xMidYMid meet'} aria-hidden="true" focusable="false">
    {name === 'sfondo' && (
      <g>
        <rect width="2100" height="900" fill="#0c110e" />
        {/* portico emiliano di notte: pilastri, archi, finestre accese al piano di sopra */}
        <rect y="0" width="2100" height="230" fill="#111813" />
        {arches.map((x) => <rect x={x + 40} y="70" width="70" height="90" fill="#1c2620" />)}
        {arches.map((x, i) => i % 3 === 1 && <rect x={x + 52} y="84" width="46" height="62" fill="#3a3216" />)}
        <path fill="#131a15" d={`M0 230 H2100 V760 H0 Z ${arches.map((x) => `M${x + 40} 760 V430 A100 100 0 0 1 ${x + 240} 430 V760 Z`).join(' ')}`} fill-rule="evenodd" />
        <rect y="760" width="2100" height="140" fill="#101612" />
        {arches.map((x) => <rect x={x + 112} y="780" width="56" height="10" fill="#18211b" />)}
      </g>
    )}
    {name === 'primo-piano' && (
      <g>
        {/* pile di carte sul bordo del banco, a sinistra e a destra */}
        <rect x="-20" y="380" width="520" height="160" fill="#18211b" transform="rotate(-4 240 460)" />
        <rect x="40" y="330" width="380" height="80" fill="#202b24" transform="rotate(6 230 370)" />
        <rect x="110" y="290" width="300" height="60" fill="#26332b" transform="rotate(-3 260 320)" />
        <rect x="1680" y="370" width="460" height="170" fill="#18211b" transform="rotate(5 1900 450)" />
        <rect x="1760" y="320" width="320" height="70" fill="#202b24" transform="rotate(-7 1920 355)" />
        <rect x="560" y="440" width="1000" height="80" fill="#121914" />
      </g>
    )}
    {name === 'email' && (
      <g>
        <rect x="6" y="10" width="188" height="120" fill={paper} />
        <path d="M6 10 L100 78 L194 10 Z" fill={paper2} />
        <rect x="150" y="22" width="30" height="22" fill={sky} />
      </g>
    )}
    {name === 'whatsapp' && (
      <g>
        <path d="M20 8 H184 Q196 8 196 20 V96 Q196 108 184 108 H56 L22 132 L30 108 H20 Q8 108 8 96 V20 Q8 8 20 8 Z" fill={wa} />
        <rect x="30" y="34" width="120" height="12" fill={green} />
        <rect x="30" y="58" width="146" height="12" fill="#9aab9f" />
        <rect x="30" y="80" width="80" height="12" fill="#9aab9f" />
      </g>
    )}
    {name === 'pdf' && (
      <g>
        <path d="M8 4 H86 L112 30 V146 H8 Z" fill={paper} />
        <path d="M86 4 V30 H112 Z" fill={paper2} />
        <rect x="8" y="40" width="52" height="24" fill={red} />
        {[78, 96, 114].map((y) => <rect x="22" y={y} width="76" height="8" fill={paper2} />)}
      </g>
    )}
    {name === 'foglio' && (
      <g>
        <rect x="6" y="6" width="188" height="128" fill={paper} />
        {[0, 1, 2, 3].map((r) => [0, 1, 2].map((c) => <rect x={18 + c * 58} y={18 + r * 28} width="52" height="22" fill={r === 0 ? '#86d9a6' : '#d5e3d8'} />))}
      </g>
    )}
    {name === 'postit' && (
      <g>
        <path d="M6 6 H114 V88 L88 114 H6 Z" fill={amber} />
        <path d="M114 88 L88 88 L88 114 Z" fill="#b8860f" />
        <rect x="20" y="30" width="70" height="8" fill="#8a6408" />
        <rect x="20" y="50" width="54" height="8" fill="#8a6408" />
      </g>
    )}
    {name === 'scontrino' && (
      <g>
        <path d="M6 4 H74 V186 L65 196 L57 186 L49 196 L40 186 L31 196 L23 186 L15 196 L6 186 Z" fill={paper} />
        {[24, 44, 64, 84, 104].map((y, i) => <rect x="14" y={y} width={i % 2 ? 36 : 52} height="7" fill={ink} opacity="0.5" />)}
        <rect x="14" y="140" width="52" height="12" fill={ink} opacity="0.7" />
      </g>
    )}
  </svg>
)}
<style>
  .art { display: block; width: 100%; height: 100%; }
  img { width: 100%; height: 100%; object-fit: inherit; }
</style>
