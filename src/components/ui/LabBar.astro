---
/** Barra delle bozze in /lab: dice cosa si sta guardando e collega le altre direzioni. */
interface Props { current: 'a' | 'b' | 'c' }
const { current } = Astro.props;
const items = [
  { id: 'a', href: '/lab/direzione-a', label: 'A sicura' },
  { id: 'b', href: '/lab/direzione-b', label: 'B audace' },
  { id: 'c', href: '/lab/direzione-c', label: 'C sperimentale' },
];
---
<div class="lab-bar">
  <p>Bozza di direzione, testi in bozza dal piano.</p>
  <nav aria-label="Direzioni">
    <a href="/lab">Tutte</a>
    {items.map((i) => <a href={i.href} aria-current={i.id === current ? 'page' : undefined}>{i.label}</a>)}
  </nav>
</div>
<style>
  .lab-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: 0.4rem var(--margin);
    background: var(--c-placeholder);
    color: #1a1406;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  nav { display: flex; gap: 1rem; }
  a { color: inherit; display: inline-block; padding-block: 0.5rem; }
  a[aria-current='page'] { text-decoration-thickness: 3px; }
</style>
