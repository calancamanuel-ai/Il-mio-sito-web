---
/** Frammento d'interfaccia: un workflow n8n d'esempio, costruito in HTML. */
interface Props { class?: string }
const { class: extra = '' } = Astro.props;
const steps = [
  { name: 'Nuova email', sub: 'Gmail · richieste@', state: 'ok' },
  { name: 'Leggi con Claude', sub: 'estrae nome, servizio, data', state: 'ok' },
  { name: 'Aggiungi riga', sub: 'Foglio "Richieste 2026"', state: 'ok' },
  { name: 'Avvisa Manuel', sub: 'Telegram · solo se urgente', state: 'wait' },
];
---
<figure class:list={['frag', extra]} data-ui>
  <div class="frag-bar"><span>Workflow: richieste dal sito</span><span class="frag-status">attivo · esempio</span></div>
  <ol class="wf-row">
    {steps.map((s) => (
      <li class={`wf-step wf-step--${s.state}`}><strong>{s.name}</strong><span>{s.sub}</span></li>
    ))}
  </ol>
  <p class="frag-foot">Ultima esecuzione: 2,4 s · 4 passaggi riusciti</p>
  <figcaption class="visually-hidden">Esempio di workflow: un'email viene letta, salvata in un foglio e, se urgente, notificata.</figcaption>
</figure>
<style>
  .frag { margin: 0; background: var(--c-surface); color: var(--c-ink); font-size: 0.95rem; min-height: 220px; display: grid; align-content: start; }
  .frag-bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 1rem; background: var(--c-line); font-weight: 600; }
  .frag-status { font-family: var(--font-mono); color: var(--c-ok); font-weight: 500; }
  .wf-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; margin: 0; padding: 1.5rem 1rem; list-style: none; position: relative; }
  .wf-row::before { content: ''; position: absolute; left: 1rem; right: 1rem; top: calc(1.5rem + 1.1rem); height: 3px; background: var(--c-action); }
  .wf-step { position: relative; display: grid; gap: 0.2rem; padding: 0.6rem 0.7rem; background: var(--c-bg); line-height: 1.25; }
  .wf-step strong { font-family: var(--font-mono); font-weight: 600; font-size: 0.9rem; }
  .wf-step span { color: var(--c-ink-soft); font-size: 0.875rem; }
  .wf-step--ok { border-left: 4px solid var(--c-ok); }
  .wf-step--wait { border-left: 4px solid var(--c-accent); }
  .frag-foot { padding: 0 1rem 1rem; font-family: var(--font-mono); color: var(--c-ink-soft); font-size: 0.875rem; }
  @media (max-width: 760px) {
    .wf-row { grid-template-columns: 1fr 1fr; }
    .wf-row::before { display: none; }
  }
</style>
