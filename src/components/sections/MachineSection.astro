---
/**
 * "La macchina del flusso" (variante "Vetro e luce"): scena three.js caricata solo quando entra
 * nello schermo. Con movimento ridotto, senza WebGL o senza JavaScript resta il fotogramma finale in HTML.
 */
import FlowMachine from '../three/FlowMachine.astro';
import { macchina } from '../../content/home';
---
<section class="machine section" aria-labelledby="macchina">
  <h2 id="macchina" class="visually-hidden">La macchina del flusso</h2>
  <p class="statement">{macchina}</p>
  <FlowMachine look="vetro" id="macchina-flusso" autoplay />
  <p class="hint">Tocca un nodo per sapere cosa fa. L'esempio mostra un flusso tipico: richieste sparse in ingresso, un preventivo, una riga in tabella e una notifica in uscita.</p>
</section>
<style>
  .machine { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .statement { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); line-height: 1.15; max-width: 30ch; }
  .machine :global(.flow) { min-height: 46svh; font-family: var(--font-text); font-size: 1.0625rem; }
  .hint { max-width: var(--measure); color: var(--c-ink-soft); }
</style>
