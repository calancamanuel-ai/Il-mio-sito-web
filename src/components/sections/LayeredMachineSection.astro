---
/**
 * PROVA (ramo lab-hero-livelli): "La macchina del flusso" a livelli in parallasse, senza WebGL.
 * Stessa storia del 3D: il caos entra, attraversa quattro nodi ed esce in ordine.
 *   Livelli: sfondo (lontano) · oggetti del caos (profondità diverse) · primo piano · catena e risultati.
 *   Nodi, linea, etichette e risultati sono HTML/SVG; sfondo, oggetti e primo piano sono immagini
 *   (oppure segnaposto disegnati finché le immagini non ci sono, vedi LayerArt).
 * Senza script o con movimento ridotto: fotogramma statico prima/dopo, tutto visibile.
 * Con le animazioni (html.motion) la coreografia la guida lo scroll: src/scripts/motion-layers.ts.
 */
import LayerArt from '../ui/LayerArt.astro';
import { macchina } from '../../content/home';
import { nodes, outputs, chaos, layouts, flowPath } from '../../scripts/layers-layout';
const W = layouts.wide, T = layouts.tall;
const pos = (w: { x: number; y: number }, t: { x: number; y: number }) => `--wx:${w.x};--wy:${w.y};--tx:${t.x};--ty:${t.y}`;
---
<section class="machine section" aria-labelledby="macchina">
  <h2 id="macchina" class="visually-hidden">La macchina del flusso</h2>
  <p class="statement">{macchina}</p>
  <div class="ly" id="macchina-livelli" data-layers>
    <div class="ly-stage" role="group" aria-label="Esempio di flusso: email, messaggi WhatsApp, PDF, fogli e appunti sparsi passano da quattro nodi (ricevi, leggi con Claude, archivia, notifica) e diventano un preventivo, una riga in tabella e una notifica.">
      <div class="ly-layer ly-bg" data-layer="bg" aria-hidden="true"><LayerArt name="sfondo" /></div>

      <div class="ly-objs" aria-hidden="true">
        {chaos.map((c) => (
          <div class={`ly-obj ly-obj--${c.kind}`} data-obj style={`${pos(c.wide, c.tall)};--wr:${c.wide.r}deg;--tr:${c.tall.r}deg;--ws:${c.wide.s};--ts:${c.tall.s}`}>
            <LayerArt name={c.kind} />
          </div>
        ))}
      </div>

      <div class="ly-layer ly-fg" data-layer="fg" aria-hidden="true"><LayerArt name="primo-piano" /></div>

      <div class="ly-layer ly-chain" data-layer="chain">
        <svg class="ly-line" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {(['wide', 'tall'] as const).map((l) => (
            <g class={`ly-path ly-path--${l}`} data-path={l}>
              <path class="ly-rail" d={flowPath(l)} />
              <path class="ly-lit" d={flowPath(l)} pathLength="1" />
            </g>
          ))}
        </svg>
        <ol class="ly-nodes" aria-label="I quattro passaggi del flusso">
          {nodes.map((n, i) => (
            <li class="ly-node is-on" data-side={W.nodes[i].y < 0.5 ? 'up' : 'down'} style={pos(W.nodes[i], T.nodes[i])}>
              <button type="button" class="ly-btn" data-node={i} aria-pressed="false" aria-describedby="ly-info">
                <span class="ly-tile" aria-hidden="true"></span>
                <span class="ly-label mono">{n.label}</span>
              </button>
            </li>
          ))}
        </ol>
        <ul class="ly-outs" aria-label="Cosa esce: dati d'esempio" data-ui>
          {outputs.map((o, i) => (
            <li class="ly-out" style={pos(W.outs[i], T.outs[i])}>
              <span class="ly-out-title">{o.title}</span>
              <span class="ly-out-meta mono">{o.meta}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="ly-info" id="ly-info" aria-live="polite" data-info data-texts={JSON.stringify(nodes.map((n) => n.text))}></p>
  </div>
  <p class="hint">Tocca un nodo per sapere cosa fa. L'esempio mostra un flusso tipico: richieste sparse in ingresso, un preventivo, una riga in tabella e una notifica in uscita.</p>
</section>

<script>
  // Tap sui nodi: funziona sempre, anche senza animazioni.
  document.querySelectorAll<HTMLElement>('[data-layers]').forEach((root) => {
    const info = root.querySelector<HTMLElement>('[data-info]')!;
    const texts: string[] = JSON.parse(info.dataset.texts || '[]');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-node]')];
    btns.forEach((b, i) => b.addEventListener('click', () => {
      const same = b.getAttribute('aria-pressed') === 'true';
      btns.forEach((x, k) => x.setAttribute('aria-pressed', String(!same && k === i)));
      info.textContent = same ? '' : texts[i];
      root.dispatchEvent(new CustomEvent('layers:select'));
    }));

    // La coreografia allo scroll parte solo quando il sito attiva le animazioni (html.motion, BaseLayout).
    const html = document.documentElement;
    const go = () => import('../../scripts/motion-layers').then((m) => m.layersScene(root));
    if (html.classList.contains('motion')) go();
    else {
      const mo = new MutationObserver(() => { if (html.classList.contains('motion')) { mo.disconnect(); go(); } });
      mo.observe(html, { attributes: true, attributeFilter: ['class'] });
    }
  });
</script>

<style>
  .machine { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .statement { font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); line-height: 1.15; max-width: 30ch; }
  .hint { max-width: var(--measure); color: var(--c-ink-soft); }

  /* La scena resta scura anche col tema chiaro: è una "finestra" sul banco di lavoro di notte. */
  .ly-stage {
    --s-bg: #0a0d0b; --s-surface: #131a15; --s-line: #3a4a40; --s-ink: #e7efe9; --s-soft: #9aab9f; --s-action: #4ade80;
    position: relative;
    container-type: inline-size;
    width: 100%;
    height: clamp(380px, 58svh, 640px);
    overflow: hidden;
    background: var(--s-bg);
    color: var(--s-ink);
  }
  .ly-layer { position: absolute; inset: 0; }
  .ly-bg { inset: -6%; }
  /* velo piatto sullo sfondo: la linea e i nodi spenti restano leggibili sopra l'illustrazione */
  .ly-bg::after { content: ""; position: absolute; inset: 0; background: rgb(10 13 11 / 0.45); }
  .ly-fg { top: auto; height: 26%; bottom: -2%; left: -6%; right: -6%; pointer-events: none; }
  .ly-bg :global(img) { object-fit: cover; }
  .ly-fg :global(img) { object-fit: cover; object-position: top; }
  .ly-objs { position: absolute; inset: 0; pointer-events: none; }
  .ly-obj {
    position: absolute;
    left: calc(var(--wx) * 100%);
    top: calc(var(--wy) * 100%);
    width: calc(var(--ws) * 100cqw);
    aspect-ratio: 10 / 7;
    translate: -50% -50%;
    transform: rotate(var(--wr));
  }
  .ly-obj--pdf { aspect-ratio: 4 / 5; }
  .ly-obj--postit { aspect-ratio: 1; }
  .ly-obj--scontrino { aspect-ratio: 2 / 5; }
  .ly-obj :global(img) { object-fit: contain; }

  .ly-line { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ly-path path { fill: none; stroke-width: 3px; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .ly-rail { stroke: var(--s-line); }
  .ly-lit { stroke: var(--s-action); stroke-dasharray: 1; stroke-dashoffset: 0; }
  .ly-path--tall { display: none; }

  .ly-nodes, .ly-outs { margin: 0; padding: 0; list-style: none; }
  .ly-node { position: absolute; left: calc(var(--wx) * 100%); top: calc(var(--wy) * 100%); translate: -50% -50%; }
  .ly-btn { position: relative; display: block; width: 48px; height: 48px; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .ly-tile { position: absolute; inset: 0; background: var(--s-line); transition: background-color var(--dur-ui) var(--ease-out), scale var(--dur-ui) var(--ease-out); }
  .ly-node.is-on .ly-tile { background: var(--s-action); }
  .ly-btn[aria-pressed='true'] .ly-tile { scale: 1.12; }
  .ly-label {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    padding: 0.3rem 0.55rem;
    background: var(--s-bg);
    color: var(--s-soft);
    font-size: 0.9375rem;
    white-space: nowrap;
    transition: color var(--dur-ui) var(--ease-out), opacity var(--dur-ui) var(--ease-out);
  }
  .ly-node[data-side='up'] .ly-label { bottom: calc(100% + 10px); }
  .ly-node[data-side='down'] .ly-label { top: calc(100% + 10px); }
  .ly-node.is-on .ly-label { color: var(--s-ink); }
  .ly-node:not(.is-on) .ly-label { opacity: 0.45; }
  .ly-btn[aria-pressed='true'] .ly-label { background: var(--s-action); color: var(--s-bg); opacity: 1; }
  .ly-btn:focus-visible { outline: 3px solid var(--s-ink); outline-offset: 4px; }

  .ly-out {
    position: absolute;
    left: calc(var(--wx) * 100%);
    top: calc(var(--wy) * 100%);
    width: clamp(10rem, 18cqw, 15rem);
    translate: -50% -50%;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    background: var(--s-surface);
  }
  .ly-out-title { font-size: 1rem; line-height: 1.2; }
  .ly-out-meta { font-size: 0.8125rem; color: var(--s-soft); }

  .ly-info { min-height: 3.2em; max-width: var(--measure); margin: var(--space-2) 0 0; }

  @media (max-width: 760px) {
    .ly-stage { height: auto; aspect-ratio: 3 / 5; }
    .ly-obj, .ly-node, .ly-out { left: calc(var(--tx) * 100%); top: calc(var(--ty) * 100%); }
    .ly-obj { width: calc(var(--ts) * 100cqw); transform: rotate(var(--tr)); }
    .ly-path--wide { display: none; }
    .ly-path--tall { display: inline; }
    .ly-btn { width: 44px; height: 44px; }
    /* in verticale le etichette stanno in colonna a destra della catena */
    .ly-node .ly-label, .ly-node[data-side] .ly-label { top: 50%; bottom: auto; left: calc((0.4 - var(--tx)) * 100cqw + 22px); translate: 0 -50%; font-size: 1rem; }
    .ly-out { width: 72cqw; padding: 0.6rem 0.8rem; }
    .ly-out-meta { display: none; }
    .ly-fg { height: 16%; }
  }
</style>
