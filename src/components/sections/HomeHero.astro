---
/**
 * Hero della home (direzione C): una frase in cui il flusso prende il posto di una parola.
 * HTML puro: titolo e pulsante si vedono subito, anche senza script e prima del 3D.
 */
import ButtonLink from '../ui/ButtonLink.astro';
import { contatti } from '../../config/sito';
import { hero } from '../../content/home';
---
<section class="hero" aria-labelledby="titolo">
  <h1 id="titolo">
    <span class="visually-hidden">Caos che diventa flusso.</span>
    <span class="sentence" aria-hidden="true">
    <span class="w" data-decode>Caos</span>
    <span class="strip" data-ui aria-hidden="true">
      <span class="strip-line"></span>
      <span class="strip-node">Ricevi</span><span class="strip-node">Leggi</span><span class="strip-node">Archivia</span><span class="strip-node">Notifica</span>
    </span>
    <span class="w" data-decode>flusso.</span>
    </span>
  </h1>
  <div class="hero-foot">
    <p class="hero-sub">{hero.sottotitolo}</p>
    <div class="hero-actions">
      <ButtonLink href={contatti.linkPrenotazione}>Prenota una call di 20 minuti</ButtonLink>
      <a class="hero-link" href="#costruisci">Prova a costruire un flusso</a>
    </div>
  </div>
</section>

<script>
  // Decodifica decorativa del titolo, una volta per visita: larghezza fissa (niente salti), < 0,7 s.
  // Il testo vero è nell'h1 (visually-hidden) e i lettori di schermo lo leggono subito.
  const words = document.querySelectorAll<HTMLElement>('[data-decode]');
  let first = true;
  try { first = !sessionStorage.getItem('titolo-visto'); sessionStorage.setItem('titolo-visto', '1'); } catch { /* storage non disponibile */ }
  if (first && words.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const glyphs = 'ABCDEFGHKLMNOPRSTUVZ01<>/#';
    words.forEach((el) => {
      const final = el.textContent || '';
      el.style.width = `${el.getBoundingClientRect().width}px`;
      el.classList.add('is-decoding');
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 650);
        const shown = Math.floor(p * final.length);
        el.textContent = final.split('').map((c, i) => (i < shown || c === '.') ? c : glyphs[(Math.random() * glyphs.length) | 0]).join('');
        if (p < 1) requestAnimationFrame(tick);
        else { el.textContent = final; el.classList.remove('is-decoding'); el.style.width = ''; }
      };
      requestAnimationFrame(tick);
    });
  }
</script>

<style>
  .hero { display: grid; gap: var(--space-5); padding: clamp(3.5rem, 11vh, 8rem) var(--margin) 0; }
  .sentence {
    display: flex;
    align-items: center;
    gap: 0.18em;
    font-size: var(--step-display);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .w { display: inline-block; white-space: nowrap; }
  .w.is-decoding { overflow: hidden; font-family: var(--font-mono); font-weight: 400; color: var(--c-action); }
  .strip {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 0.78em;
    padding-inline: 0.25em;
    border-radius: var(--radius-strip);
    background: var(--c-surface);
  }
  .strip-line { position: absolute; left: 0.5em; right: 0.5em; top: 50%; height: 3px; background: var(--c-action); }
  .strip-node {
    position: relative;
    padding: 0.4rem 0.6rem;
    background: var(--c-bg);
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 0.6rem + 0.4vw, 1rem);
    letter-spacing: 0;
  }
  .hero-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-3); }
  .hero-sub { max-width: 44ch; font-size: var(--step-lead); line-height: 1.35; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .hero-link { display: inline-block; padding-block: 0.6rem; }
  @media (max-width: 900px) {
    .sentence { flex-wrap: wrap; font-size: 21vw; gap: 0.1em 0; }
    .strip { order: 1; flex: 1 0 100%; height: auto; aspect-ratio: 5 / 2; display: grid; grid-template-columns: 1fr 1fr; place-content: center; gap: 0.6rem; padding: 1rem; }
    .strip-line { left: 50%; right: auto; top: 1rem; bottom: 1rem; width: 3px; height: auto; }
    .strip-node { text-align: center; }
    .w:last-of-type { order: 2; }
    .hero-sub { font-size: var(--step-body); }
  }
</style>
