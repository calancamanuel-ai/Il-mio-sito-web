---
/**
 * Apertura delle pagine interne: titolo, risposta breve in alto (leggibile anche
 * dai motori AI) e azione. Lo slot "aside" ospita la prova (un frammento d'interfaccia).
 */
import ButtonLink from '../ui/ButtonLink.astro';
import { contatti } from '../../config/sito';
interface Props { title: string; answer: string; cta?: string }
const { title, answer, cta = 'Prenota una call di 20 minuti' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['intro', { 'intro--split': hasAside }]} aria-labelledby="titolo">
  <div class="intro-text">
    <h1 id="titolo">{title}</h1>
    <p class="answer">{answer}</p>
    <ButtonLink href={contatti.linkPrenotazione}>{cta}</ButtonLink>
  </div>
  {hasAside && <div class="intro-aside"><slot name="aside" /></div>}
</section>
<style>
  .intro { display: grid; gap: var(--space-4); padding: clamp(3rem, 8vh, 6rem) var(--margin) 0; }
  .intro--split { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: center; }
  .intro-text { display: grid; gap: var(--space-3); justify-items: start; }
  h1 { font-size: var(--step-head); font-weight: 300; line-height: 1; max-width: 14ch; }
  .answer { font-size: var(--step-lead); line-height: 1.35; max-width: 34ch; }
  @media (max-width: 900px) { .intro--split { grid-template-columns: minmax(0, 1fr); } }
</style>
