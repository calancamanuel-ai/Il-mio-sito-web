---
/** "Il lunedì mattina": le attività ripetitive e cosa ne resta quando le fa un sistema. Statico in fase 2. */
import { lunedi } from '../../content/home';
import ArchiveFigure from '../ui/ArchiveFigure.astro';
const totale = lunedi.reduce((s, m) => s + m.min, 0);
---
<section class="monday section" aria-labelledby="lunedi">
  <h2 id="lunedi" class="section-title">Il lunedì mattina</h2>
  <div class="monday-grid">
  <ol class="monday-list">
    {lunedi.map((m) => (
      <li>
        <span class="mono time">{m.t}</span>
        <p class="was"><s>{m.prima}</s></p>
        <p class="now">{m.dopo} <span class="mono">−{m.min} min</span></p>
      </li>
    ))}
  </ol>
  <ArchiveFigure id="curtiMercato" class="monday-fig" />
  </div>
  <p class="sum">Una mattina d'esempio: <span class="mono">{Math.floor(totale / 60)} h {totale % 60} min</span> che tornano a te. Attività e minuti veri li misuriamo nell'analisi gratuita.</p>
</section>
<style>
  .monday-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-5); align-items: start; margin-top: var(--space-5); }
  .monday-grid :global(.monday-fig) { position: sticky; top: 6rem; }
  @media (max-width: 900px) { .monday-grid { grid-template-columns: minmax(0, 1fr); } .monday-grid :global(.monday-fig) { position: static; } }
  .monday-list { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .monday-list li { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 0.4rem var(--space-3); }
  .time { grid-row: span 2; color: var(--c-action); padding-top: 0.5em; }
  .was { font-size: var(--step-lead); line-height: 1.2; }
  .was s { text-decoration-thickness: 3px; text-decoration-color: var(--c-action); color: var(--c-ink-soft); }
  .now { max-width: var(--measure); }
  .now .mono { color: var(--c-action); }
  .sum { margin-top: var(--space-5); max-width: var(--measure); font-size: var(--step-lead); line-height: 1.35; }
  @media (max-width: 600px) {
    .monday-list li { grid-template-columns: minmax(0, 1fr); }
    .time { grid-row: auto; padding: 0; }
  }
</style>
