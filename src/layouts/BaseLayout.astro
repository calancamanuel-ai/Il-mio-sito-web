---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import { brand, sito, isPlaceholder } from '../config/sito';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import MobileBar from '../components/ui/MobileBar.astro';
import DraftBar from '../components/ui/DraftBar.astro';

interface Props {
  title: string;
  description: string;
  /** false per pagine senza intestazione e piè di pagina (prove in /lab). */
  chrome?: boolean;
}
const { title, description, chrome = true } = Astro.props;
const brandName = isPlaceholder(brand.nome) ? 'Brand da definire' : brand.nome;
const fullTitle = `${title} · ${brandName}`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {sito.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    {sito.noindex && <DraftBar />}
    <slot name="top" />
    {chrome && <SiteHeader />}
    <main id="contenuto">
      <slot />
    </main>
    {chrome && <SiteFooter />}
    {chrome && <MobileBar />}
    <script>
      // Animazioni: si caricano dopo il primo disegno e solo con il movimento consentito.
      // Così titolo e pulsanti sono subito visibili, e il JavaScript iniziale resta sotto i 50 KB.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const start = () => import('../scripts/motion').then((m) => m.startMotion());
        const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 200));
        if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
      }
    </script>
  </body>
</html>
